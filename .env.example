# Environment variables for this project.
# Complete list and purpose: DEPLOYMENT_PLAN.md Section 6.
# Copy to `.env` and fill in values locally. `.env` is gitignored (CLAUDE.md rule 15).
# This file documents variable NAMES ONLY — never commit a value here.
#
# The DEPLOYED architecture requires no third-party API keys (a direct consequence
# of DECISION_REGISTER.md E8 and E10), so nothing in the Backend/Frontend sections
# below is a secret. The Research section IS secret-bearing — see the warning there.

# --- Research / GPU sessions (NOT used by the deployed app) ---
#
# Read by research/src/models/transformer.py, evaluate_checkpoint.py and
# results_push.py, and by the GPU notebook via research/src/notebook_env.py.
# On Colab/Kaggle these come from the platform's own secret store, never from a
# file; this section is for running those scripts locally.

# Hugging Face access token. THIS ONE IS A REAL SECRET — treat it like a password.
# Least privilege: a READ token is enough to pull checkpoints and metrics back
# down. Only use a WRITE token if you are actually pushing checkpoints or results.
# Revoke at huggingface.co/settings/tokens if it is ever exposed.
HF_TOKEN=

# HF namespace the staging repos live under (a username or org, e.g. RehmanAyoub).
# Not a secret — it is just a name.
HF_STAGING_PREFIX=

# --- Backend ---

# Hugging Face Hub model repo the backend loads at startup (E17).
MODEL_REPO_ID=

# Pinned model revision — a commit SHA or tag, never a floating branch
# (REPRODUCIBILITY.md Sections 1 and 8).
MODEL_REVISION=

# CORS allow-list. Comma-separated exact origins, never a wildcard
# (DEPLOYMENT_PLAN.md Section 2).
ALLOWED_ORIGINS=

# In-process IP-based rate limit (E10).
RATE_LIMIT_PER_MINUTE=

# Input bounds enforced server-side (SECURITY.md — the client-side checks in
# frontend/lib/validation.ts are UX only and are never the trust boundary).
MAX_TEXT_LENGTH=
MIN_TEXT_LENGTH=

# URL article-extraction limits (SECURITY.md, E11).
EXTRACTION_TIMEOUT_SECONDS=
EXTRACTION_MAX_BYTES=

# Logging verbosity.
LOG_LEVEL=

# --- Frontend ---

# Public base URL of the deployed backend. The only env var the frontend needs
# (E16); NEXT_PUBLIC_ prefixed values are exposed to the browser by design.
NEXT_PUBLIC_API_BASE_URL=
