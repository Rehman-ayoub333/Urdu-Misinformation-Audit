        "H": {
          "name": "length_only",
          "description": "Experiment H — length-only baseline. Logistic regression over LENGTH-DERIVED FEATURES ONLY, with no access to article content whatsoever. This is the direct operationalisation of RQ3 (MASTER_PROJECT_BLUEPRINT.md Part 32: \"the fastest way to isolate the length shortcut — a linear model on word count alone\"). Its macro-F1 is the floor that any content-based model must clear to have demonstrated it learned something beyond article length.\n",
          "classifier": "logistic_regression",
          "features": [
            "n_chars",
            "n_words"
          ],
          "standardise": true,
          "params": {
            "C": 1.0,
            "max_iter": 2000,
            "class_weight": "balanced",
            "solver": "liblinear"
          }
        },
        "H2": {
          "name": "length_only",
          "description": "Experiment H2 — length-only baseline, NONLINEAR. Added by DECISION_REGISTER.md M3-1 (approved 2026-08-14). Identical to H in every respect except the classifier: same two length-derived features, still no access to article content whatsoever. It exists because Milestone 3 measured Ax-to-Grind's length↔label relationship as U-shaped (fake at both extremes, real in a narrow middle band), which a linear model structurally cannot express — so H's macro-F1 is a FLOOR on the length shortcut, not a measurement of it. H2 supplies the ceiling. RQ3 reports both.\n",
          "classifier": "decision_tree",
          "features": [
            "n_chars",
            "n_words"
          ],
          "standardise": false,
          "params": {
            "max_depth": 2,
            "class_weight": "balanced"
          },
          "diagnostic_depths": [
            2,
            5
          ]
        }
      },
